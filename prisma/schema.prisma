generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  firstName                String
  lastName                 String
  role                     UserRole  @default(OWNER)
  isActive                 Boolean   @default(true)
  isEmailVerified          Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?

  /// Two-factor authentication (TOTP). `twoFactorPendingSecret` holds a secret
  /// that has been shown to the user but not yet proven with a valid code, so a
  /// half-finished enrolment can never lock anyone out.
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorConfirmedAt   DateTime?
  /// One-time recovery codes, stored hashed.
  twoFactorRecoveryCodes String[]  @default([])

  passwordChangedAt DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  company       Company?
  sessions            Session[]
  activities          InvoiceActivity[]
  quotationActivities QuotationActivity[]
  memberships         CompanyMember[]   @relation("MemberUser")
  invitesSent   CompanyMember[]   @relation("MemberInvitedBy")
  notifications Notification[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  isRevoked        Boolean  @default(false)
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Company {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  name                   String
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  state                  String?
  country                String             @default("India")
  postalCode             String?
  gstin                  String?
  pan                    String?
  logoUrl                String?
  invoicePrefix          String             @default("INV-")
  nextInvoiceNumber      Int                @default(1001)
  defaultTaxRate         Decimal            @default(18.00) @db.Decimal(5, 2)
  bankName               String?
  accountNumber          String?
  ifscCode               String?
  branch                 String?
  accountHolder          String?
  upiId                  String?
  paymentInstructions    String?
  /// Which payment rails the business accepts; printed on the invoice PDF and
  /// used to limit the methods offered when recording a payment.
  acceptedPaymentMethods PaymentMethod[]    @default([BANK_TRANSFER, UPI, CASH, CHEQUE])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers              Customer[]
  invoices               Invoice[]
  payments               Payment[]
  products               Product[]
  invoiceSettings        InvoiceSettings?
  sequences              DocumentSequence[]
  notes                  CreditDebitNote[]
  activities             InvoiceActivity[]
  quotations             Quotation[]
  quotationActivities    QuotationActivity[]
  vendors                Vendor[]
  purchaseBills          PurchaseBill[]
  purchasePayments       PurchasePayment[]
  members                CompanyMember[]
  notifications          Notification[]

  @@map("companies")
}

model Customer {
  id                 String             @id @default(uuid())
  companyId          String
  /// Human-readable account code (e.g. CUST-0001), generated from settings.
  customerCode       String?
  name               String
  email              String?
  phone              String?
  type               CustomerType       @default(BUSINESS)
  gstin              String?
  address            String?
  factoryAddress     String?
  city               String?
  state              String?
  country            String             @default("India")
  postalCode         String?
  officeNo           String?
  contactPerson      String?
  accountGroup       String?
  openingBalance     Decimal?           @default(0.00) @db.Decimal(14, 2)
  openingBalanceDate DateTime?
  balanceType        String?
  partyCategory      String?
  narration1         String?
  narration2         String?
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  quotations         Quotation[]
  products           Product[]
  notes              CreditDebitNote[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@map("customers")
}

model Product {
  id          String    @id @default(uuid())
  companyId   String
  customerId  String?
  category    String?   @default("General")
  productCode String?
  name        String
  description String?
  sku         String?
  price       Decimal   @db.Decimal(12, 2)
  unit        String    @default("PCS")
  taxRate     Decimal   @default(18.00) @db.Decimal(5, 2)
  hsnSacCode  String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([companyId, productCode])
  @@index([companyId])
  @@index([customerId])
  @@index([companyId, category])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Invoicing
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  customerId    String
  invoiceNumber String
  /// Numeric part of the number, kept so sequences can be audited and sorted.
  sequenceNo    Int           @default(0)
  /// Indian financial year the invoice falls in, e.g. "2026-27".
  financialYear String        @default("")
  status        InvoiceStatus @default(DRAFT)
  billType      String        @default("TAX_INVOICE")
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  poNumber      String?
  orderDate     DateTime?
  reference     String?
  currency      String        @default("INR")

  /// Dispatch and Challan / Logistics details
  challanNo      String?
  challanDate    DateTime?
  modeOfDispatch String?
  lhNo           String?
  lhDate         DateTime?
  dcNo           String?
  dcDate         DateTime?
  paymentTerms   String?

  /// Snapshot of the buyer as it was when the invoice was issued. A later edit
  /// to the customer record must never silently rewrite an issued document.
  billingName       String  @default("")
  billingEmail      String?
  billingPhone      String?
  billingGstin      String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingCountry    String  @default("India")
  billingPostalCode String?

  /// Destination state for GST. Equal to the seller state => CGST+SGST, else IGST.
  placeOfSupply     String?
  placeOfSupplyCode String?
  isIgst            Boolean @default(false)
  isReverseCharge   Boolean @default(false)

  subtotal        Decimal @db.Decimal(14, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  taxableAmount   Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount       Decimal @db.Decimal(14, 2)
  cgstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  sgstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  igstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  extraCharges    Decimal @default(0.00) @db.Decimal(14, 2)
  roundOff        Decimal @default(0.00) @db.Decimal(8, 2)
  grandTotal      Decimal @db.Decimal(14, 2)
  amountPaid      Decimal @default(0.00) @db.Decimal(14, 2)
  creditNoteTotal Decimal @default(0.00) @db.Decimal(14, 2)
  debitNoteTotal  Decimal @default(0.00) @db.Decimal(14, 2)
  balanceDue      Decimal @db.Decimal(14, 2)

  notes           String?
  terms           String?
  internalNotes   String?
  cancelledReason String?

  sentAt      DateTime?
  viewedAt    DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items      InvoiceItem[]
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer          @relation(fields: [customerId], references: [id])
  payments   Payment[]
  notesDocs  CreditDebitNote[]
  activities InvoiceActivity[]
  quotations Quotation[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, billType])
  @@index([customerId])
  @@index([status])
  @@index([companyId, issueDate])
  @@index([companyId, financialYear])
  @@index([companyId, status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  name        String
  description String?
  hsnSacCode  String?
  unit        String  @default("PCS")
  sortOrder   Int     @default(0)

  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  taxRate         Decimal @default(0.00) @db.Decimal(5, 2)

  /// Gross line value before discount (quantity x unitPrice).
  subtotal      Decimal @db.Decimal(14, 2)
  /// Value GST is charged on (subtotal - discountAmount).
  taxableAmount Decimal @default(0.00) @db.Decimal(14, 2)
  cgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  sgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  sgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  igstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  igstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  companyId       String
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([companyId])
  @@index([companyId, paymentDate])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Credit / debit notes
// ---------------------------------------------------------------------------

model CreditDebitNote {
  id            String     @id @default(uuid())
  companyId     String
  customerId    String
  invoiceId     String?
  noteType      NoteType
  noteNumber    String
  sequenceNo    Int        @default(0)
  financialYear String     @default("")
  status        NoteStatus @default(DRAFT)
  noteDate      DateTime   @default(now())
  reason        String?

  billingName       String  @default("")
  billingGstin      String?
  billingAddress    String?
  billingState      String?
  placeOfSupply     String?
  placeOfSupplyCode String?
  isIgst            Boolean @default(false)

  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  roundOff       Decimal @default(0.00) @db.Decimal(8, 2)
  grandTotal     Decimal @db.Decimal(14, 2)

  notes     String?
  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id])
  invoice  Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items    CreditDebitNoteItem[]

  @@unique([companyId, noteNumber])
  @@index([companyId, noteType])
  @@index([customerId])
  @@index([invoiceId])
  @@index([companyId, noteDate])
  @@map("credit_debit_notes")
}

model CreditDebitNoteItem {
  id          String  @id @default(uuid())
  noteId      String
  productId   String?
  name        String
  description String?
  hsnSacCode  String?
  unit        String  @default("PCS")
  sortOrder   Int     @default(0)

  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  taxRate         Decimal @default(0.00) @db.Decimal(5, 2)
  subtotal        Decimal @db.Decimal(14, 2)
  taxableAmount   Decimal @default(0.00) @db.Decimal(14, 2)
  cgstRate        Decimal @default(0.00) @db.Decimal(5, 2)
  cgstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  sgstRate        Decimal @default(0.00) @db.Decimal(5, 2)
  sgstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  igstRate        Decimal @default(0.00) @db.Decimal(5, 2)
  igstAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount       Decimal @db.Decimal(14, 2)
  total           Decimal @db.Decimal(14, 2)

  note CreditDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("credit_debit_note_items")
}

// ---------------------------------------------------------------------------
// Reminders, activity and settings
// ---------------------------------------------------------------------------

model InvoiceActivity {
  id          String       @id @default(uuid())
  companyId   String
  invoiceId   String
  userId      String?
  action      ActivityType
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([companyId, createdAt])
  @@map("invoice_activities")
}

model InvoiceSettings {
  id        String @id @default(uuid())
  companyId String @unique

  // Numbering
  invoicePrefix       String          @default("INV")
  invoiceSuffix       String?
  creditNotePrefix    String          @default("CN")
  debitNotePrefix     String          @default("DN")
  quotationPrefix     String          @default("QT")
  numberSeparator     String          @default("-")
  numberPadding       Int             @default(4)
  startNumber         Int             @default(1)
  resetMode           NumberResetMode @default(FINANCIAL_YEAR)
  includeYearInNumber Boolean         @default(true)

  // Defaults applied to new invoices
  defaultDueDays  Int     @default(15)
  defaultTaxRate  Decimal @default(18.00) @db.Decimal(5, 2)
  defaultCurrency String  @default("INR")
  defaultTerms    String?
  defaultNotes    String?

  // Document presentation
  themeColor        String  @default("#7c4a27")
  template          String  @default("classic")
  /// Maps to a PDF core font family: HELVETICA, TIMES or COURIER.
  fontFamily        String  @default("HELVETICA")
  /// grid | minimal | striped - how item rows are ruled on the document.
  tableStyle        String  @default("grid")
  /// Which side the authorised-signatory block sits on.
  signaturePosition String  @default("right")
  showHsnColumn     Boolean @default(true)
  showDiscount      Boolean @default(true)
  showBankDetails   Boolean @default(true)
  showSignature     Boolean @default(true)
  signatureUrl      String?
  footerNote        String?

  // Tax regime
  gstEnabled           Boolean @default(true)
  /// When true, entered unit prices are treated as tax-inclusive and the tax is
  /// backed out of them instead of added on top.
  pricesIncludeTax     Boolean @default(false)
  enableReverseCharge  Boolean @default(true)
  hsnRequiredOnProduct Boolean @default(true)

  // Customer directory defaults
  customerCodePrefix   String  @default("CUST")
  customerCreditDays   Int     @default(15)
  customerRequirePhone Boolean @default(true)
  customerRequireState Boolean @default(true)
  customerRequireGstin Boolean @default(false)

  // Product catalogue defaults
  productCodePrefix   String @default("PRD")
  defaultUnit         String @default("PCS")
  defaultDiscountMode String @default("PERCENT")

  // Notifications
  notifyEvents  NotificationEvent[] @default([INVOICE_CREATED, INVOICE_PAID, INVOICE_OVERDUE, PAYMENT_RECEIVED, NOTE_ISSUED])
  notifyEmail   Boolean             @default(true)
  notifyInApp   Boolean             @default(true)
  notifyBrowser Boolean             @default(false)

  // Behaviour
  enableRoundOff  Boolean @default(true)
  autoMarkOverdue Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("invoice_settings")
}

model DocumentSequence {
  id           String       @id @default(uuid())
  companyId    String
  documentType DocumentType
  /// "ALL" when numbering never resets, otherwise the financial year / month key.
  periodKey    String
  nextNumber   Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, periodKey])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Team & notifications
// ---------------------------------------------------------------------------

/// A person's access to a business.
///
/// The row is created when the invite is sent, before the invitee has an
/// account, so `userId` stays null until they accept. `email` is therefore the
/// stable identity of a membership, not `userId`.
model CompanyMember {
  id        String       @id @default(uuid())
  companyId String
  userId    String?
  email     String
  role      UserRole     @default(STAFF)
  status    MemberStatus @default(INVITED)

  /// Invite tokens are stored hashed; the plaintext only ever exists in the
  /// invitation email.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String?
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?   @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([userId])
  @@map("company_members")
}

/// In-app notification. One row per recipient so read state is per person.
model Notification {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  event     NotificationEvent
  title     String
  body      String?
  /// Deep link into the app, e.g. /invoices/<id>.
  link      String?
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  STAFF
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum NoteType {
  CREDIT
  DEBIT
}

enum NoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  SENT
  VIEWED
  PAYMENT_RECORDED
  PAYMENT_DELETED
  CANCELLED
  DUPLICATED
  PDF_DOWNLOADED
  EMAIL_SENT
  REMINDER_SENT
  NOTE_LINKED
  DELETED
}

enum NumberResetMode {
  NEVER
  YEARLY
  MONTHLY
  FINANCIAL_YEAR
}

enum DocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  PURCHASE_BILL
  CUSTOMER
  PRODUCT
  QUOTATION
}

/// Business events a user can subscribe to in notification settings.
enum NotificationEvent {
  INVOICE_CREATED
  INVOICE_PAID
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  CUSTOMER_ADDED
  NOTE_ISSUED
}

enum PurchaseBillStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ItcEligibility {
  INPUTS
  CAPITAL_GOODS
  INPUT_SERVICES
  INELIGIBLE
}

enum ItemCategory {
  GOODS
  SERVICE
  RAW_MATERIAL
  CAPITAL_ASSET
  EXPENSE
}

// ---------------------------------------------------------------------------
// Purchases & Vendors
// ---------------------------------------------------------------------------

model Vendor {
  id                 String            @id @default(uuid())
  companyId          String
  name               String
  tradeName          String?
  contactPerson      String?
  email              String?
  phone              String?
  type               CustomerType      @default(BUSINESS)
  gstin              String?
  pan                String?
  address            String?
  city               String?
  state              String?
  country            String            @default("India")
  postalCode         String?
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  branch             String?
  openingBalance     Decimal?          @default(0.00) @db.Decimal(14, 2)
  openingBalanceDate DateTime?
  balanceType        String?           @default("CR")
  paymentTerms       String?
  partyCategory      String?
  narration          String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills      PurchaseBill[]
  payments           PurchasePayment[]

  @@index([companyId])
  @@map("vendors")
}

model PurchaseBill {
  id                  String             @id @default(uuid())
  companyId           String
  vendorId            String?
  billNumber          String
  vendorInvoiceNumber String?
  sequenceNo          Int                @default(0)
  financialYear       String             @default("")
  status              PurchaseBillStatus @default(RECEIVED)
  billDate            DateTime           @default(now())
  dueDate             DateTime?
  paymentTerms        String?
  currency            String             @default("INR")

  /// Logistics & Inward references
  poNumber        String?
  poDate          DateTime?
  grnNumber       String?
  grnDate         DateTime?
  transporterName String?
  vehicleNumber   String?
  lrNumber        String?
  lrDate          DateTime?

  /// Vendor Snapshot at time of bill
  vendorName       String  @default("")
  vendorGstin      String?
  vendorPhone      String?
  vendorEmail      String?
  vendorAddress    String?
  vendorCity       String?
  vendorState      String?
  vendorCountry    String  @default("India")
  vendorPostalCode String?

  /// GST & Tax compliance
  placeOfSupply     String?
  placeOfSupplyCode String?
  isIgst            Boolean        @default(false)
  isReverseCharge   Boolean        @default(false)
  itcEligibility    ItcEligibility @default(INPUTS)

  /// Financials
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  otherCharges   Decimal @default(0.00) @db.Decimal(14, 2)
  roundOff       Decimal @default(0.00) @db.Decimal(8, 2)
  grandTotal     Decimal @db.Decimal(14, 2)
  amountPaid     Decimal @default(0.00) @db.Decimal(14, 2)
  balanceDue     Decimal @db.Decimal(14, 2)

  notes         String?
  terms         String?
  internalNotes String?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor   Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items    PurchaseBillItem[]
  payments PurchasePayment[]

  @@unique([companyId, billNumber])
  @@index([companyId])
  @@index([vendorId])
  @@index([status])
  @@index([companyId, billDate])
  @@index([companyId, financialYear])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id             String       @id @default(uuid())
  purchaseBillId String
  productId      String?
  name           String
  description    String?
  hsnSacCode     String?
  category       ItemCategory @default(GOODS)
  unit           String       @default("PCS")
  sortOrder      Int          @default(0)

  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  taxRate         Decimal @default(0.00) @db.Decimal(5, 2)

  subtotal      Decimal @db.Decimal(14, 2)
  taxableAmount Decimal @default(0.00) @db.Decimal(14, 2)
  cgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  sgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  sgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  igstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  igstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

model PurchasePayment {
  id              String        @id @default(uuid())
  purchaseBillId  String
  companyId       String
  vendorId        String?
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([purchaseBillId])
  @@index([companyId])
  @@index([vendorId])
  @@index([companyId, paymentDate])
  @@map("purchase_payments")
}

// ---------------------------------------------------------------------------
// Quotations & Estimates
// ---------------------------------------------------------------------------

model Quotation {
  id                 String          @id @default(uuid())
  companyId          String
  customerId         String?
  convertedInvoiceId String?
  quotationNumber    String
  sequenceNo         Int             @default(0)
  financialYear      String          @default("")
  status             QuotationStatus @default(DRAFT)
  subject            String?
  inquiryNumber      String?
  inquiryDate        DateTime?
  referenceNumber    String?
  quotationDate      DateTime        @default(now())
  validUntil         DateTime?
  paymentTerms       String?         @default("50% Advance")
  currency           String          @default("INR")

  /// Customer Snapshot at time of quotation
  billingName       String  @default("")
  billingEmail      String?
  billingPhone      String?
  billingGstin      String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingCountry    String  @default("India")
  billingPostalCode String?

  /// Destination state for GST
  placeOfSupply     String?
  placeOfSupplyCode String?
  isIgst            Boolean @default(false)

  /// Financial Totals
  subtotal                  Decimal @db.Decimal(14, 2)
  discountAmount            Decimal @default(0.00) @db.Decimal(14, 2)
  taxableAmount             Decimal @default(0.00) @db.Decimal(14, 2)
  cgstAmount                Decimal @default(0.00) @db.Decimal(14, 2)
  sgstAmount                Decimal @default(0.00) @db.Decimal(14, 2)
  igstAmount                Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount                 Decimal @db.Decimal(14, 2)
  forwardingPackagingAmount Decimal @default(0.00) @db.Decimal(14, 2)
  secondTotal               Decimal @default(0.00) @db.Decimal(14, 2)
  roundOff                  Decimal @default(0.00) @db.Decimal(8, 2)
  grandTotal                Decimal @db.Decimal(14, 2)

  notes           String?
  terms           String?
  rejectionReason String?
  cancelledReason String?

  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  convertedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  convertedInvoice Invoice?            @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  activities       QuotationActivity[]

  @@unique([companyId, quotationNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([companyId, quotationDate])
  @@index([companyId, financialYear])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  productId   String?
  name        String
  description String?
  hsnSacCode  String?
  unit        String  @default("PCS")
  sortOrder   Int     @default(0)

  quantity        Decimal @db.Decimal(12, 3)
  rate            Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(14, 2)
  taxRate         Decimal @default(0.00) @db.Decimal(5, 2)

  subtotal      Decimal @db.Decimal(14, 2)
  taxableAmount Decimal @default(0.00) @db.Decimal(14, 2)
  cgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  sgstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  sgstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  igstRate      Decimal @default(0.00) @db.Decimal(5, 2)
  igstAmount    Decimal @default(0.00) @db.Decimal(14, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  amount        Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationActivity {
  id          String       @id @default(uuid())
  companyId   String
  quotationId String
  userId      String?
  action      ActivityType
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quotationId, createdAt])
  @@index([companyId, createdAt])
  @@map("quotation_activities")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

